# gh-pages branch .gitignore
# ─────────────────────────────────────────────────────────────────────────────
# This is a static deployment branch — only site assets belong here.

# Node / build tooling (not part of the published site)
node_modules/

# Loose build output at root (use _misc/build-artifacts/ for archived builds)
/dist/
/angularapp/

# Exceptions: builds archived inside _misc/ ARE tracked
!_misc/build-artifacts/dist/
!_misc/build-artifacts/angularapp/

# OS noise
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db

# Editor / IDE config (deployment branch only — no dev tools needed here)
/vscode/
.idea/
