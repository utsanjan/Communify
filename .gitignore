firebase-debug.log
.runtimeconfig.json

# ── Test coverage ─────────────────────────────────────────────────────────────
coverage/

# ── OS / metadata ─────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db

# ── Editor / IDE ─────────────────────────────────────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
