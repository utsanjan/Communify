# master branch .gitignore — Angular 9 / Communify project
# ─────────────────────────────────────────────────────────────────────────────

# ── Node / npm ────────────────────────────────────────────────────────────────
node_modules/

# ── Angular build outputs ─────────────────────────────────────────────────────
dist/
angularapp/
tmp/
out-tsc/

# ── Angular cache ─────────────────────────────────────────────────────────────
.angular/

# ── Firebase hosting / emulator ───────────────────────────────────────────────
.firebase/
firebase-debug.log
.runtimeconfig.json

# ── Test coverage ─────────────────────────────────────────────────────────────
coverage/

# ── JVM crash reports (generated by Java/VS Code Java extension) ──────────────
hs_err_pid*.log
replay_pid*.log

# ── Stale build chunk artifacts that end up in project root ──────────────────
[0-9].*.js
[0-9][0-9].*.js
common.*.js
main.*.js
runtime.*.js
polyfills.*.js
scripts.*.js

# ── Unrelated sub-projects that should not be in this repo layer ──────────────
talkE/
social-network-app/

# ── OS / metadata ─────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db

# ── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
