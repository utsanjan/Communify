# gh-pages branch .gitignore
# ─────────────────────────────────────────────────────────────────────────────
# This is a static deployment branch — only site assets belong here.

# Node / build tooling (not part of the published site)
node_modules/

# Local build output directories (use _misc/build-artifacts/ for committed builds)
dist/
angularapp/

# OS noise
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db

# Editor / IDE config (deployment branch only — no dev tools needed here)
.cursor/
.vscode/
.idea/
